# ID of the GitHub App the tenant bot acts as. Registered in GitHub as the
# GH_APP_ID variable and mapped to this name by the deploy workflow.
GITHUB_APP_ID=

# Slug of the GitHub App, used to build the installation URL. Registered in
# GitHub as the GH_APP_SLUG variable and mapped to this name by the deploy
# workflow.
GITHUB_APP_SLUG=

# Private key of the GitHub App, used to sign the app JWT. Registered in
# GitHub as the GH_APP_PRIVATE_KEY secret and mapped to this name by the
# deploy workflow.
GITHUB_APP_PRIVATE_KEY=

# Client ID of the GitHub App, used for the user authorization flow of the
# signing key endpoints. It is a variable, not a secret.
GH_APP_CLIENT_ID=

# Client secret of the GitHub App, used for the user authorization flow of
# the signing key endpoints.
GH_APP_CLIENT_SECRET=
