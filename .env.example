# ID of the GitHub App the tenant bot acts as.
GH_APP_ID=

# Private key of the GitHub App, used to sign the app JWT.
GH_APP_PRIVATE_KEY=

# Client ID of the GitHub App, used as the client ID of the github-app
# OAuth provider. It is a variable, not a secret.
GH_APP_CLIENT_ID=

# Client secret of the GitHub App, used as the client secret of the
# github-app OAuth provider.
GH_APP_CLIENT_SECRET=

# Client ID of the GitHub OAuth App dedicated to the signing key management
# authorization. It is a variable, not a secret.
GH_OATH_CLIENT_ID=

# Client secret of the GitHub OAuth App dedicated to the signing key
# management authorization.
GH_OAUTH_CLIENT_SECRET=

# JSON array of the origins allowed to call this worker cross-origin; also
# the origins better-auth trusts for cookie/CSRF checks. It is a variable.
TRUSTED_ORIGINS=

# JSON array of the origins accepted for passkey (WebAuthn) ceremonies,
# including Android `android:apk-key-hash:` origins. It is a variable.
WEBAUTHN_EXPECTED_ORIGINS=

# JSON array of the hostnames Cloudflare Turnstile may report. It is a variable.
TURNSTILE_HOSTNAMES=

# Maximum number of batch works run concurrently. It is a variable.
BATCH_WORKS_MAX_CONCURRENCY=
