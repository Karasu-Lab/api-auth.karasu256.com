# ID of the GitHub App the tenant bot acts as.
GH_APP_ID=

# Private key of the GitHub App, used to sign the app JWT.
GH_APP_PRIVATE_KEY=

# Client ID of the GitHub App, used as the client ID of the github-app
# OAuth provider. It is a variable, not a secret.
GH_APP_CLIENT_ID=

# Client secret of the GitHub App, used as the client secret of the
# github-app OAuth provider.
GH_APP_CLIENT_SECRET=

# Client ID of the GitHub OAuth App dedicated to the signing key management
# authorization. It is a variable, not a secret.
GH_OATH_CLIENT_ID=

# Client secret of the GitHub OAuth App dedicated to the signing key
# management authorization.
GH_OAUTH_CLIENT_SECRET=
