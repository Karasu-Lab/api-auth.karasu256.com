{
  "name": "api-auth.karasu256.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite dev --port 8790 --strictPort",
    "build": "tsc && vite build && wrangler deploy --dry-run",
    "types": "wrangler types --env-interface Env",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.development.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^26.6.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.147.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.12",
    "@better-auth/core": "^1.7.12",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/oauth-provider": "^1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/sso": "1.7.12",
    "@karasu-lab/db": "0.1.0-2e01f94",
    "@karasu-lab/sdk": "0.1.0-b98320f",
    "@karasu-lab/types": "0.1.0-1768cec",
    "@karasu-lab/utils": "0.1.0-11f53a9",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.4.29",
    "jose": "^6.2.5",
    "zod": "^4.5.4"
  }
}
