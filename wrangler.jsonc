{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-auth-karasu256-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "routes": [{ "pattern": "api-auth.karasu256.com", "custom_domain": true }],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://api-auth.karasu256.com",
    "AUTH_UI_URL": "https://auth.karasu256.com",
    "SSO_UI_URL": "https://sso.karasu256.com",
    "ACCOUNTS_URL": "https://accounts.karasu256.com",
    "MCP_URL": "https://mcp.karasu256.com/mcp",
    "API_URL": "https://api.karasu256.com",
    "MC_AUTH_URL": "https://mc-auth.karasu256.com",
    "BASE_DOMAIN": "karasu256.com",
  },
  "ratelimits": [{ "name": "CLOUDFLARE_SIGN_IN_LOOKUP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "kv_namespaces": [{ "binding": "MINECRAFT_STATUS_RATE_LIMIT_KV" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "858c91ee12f54fb191816dd81a34ffe0",
      "localConnectionString": "postgres://postgres:postgres@localhost:5433/karasu256",
    },
  ],
  "env": {
    "dev": {
      "name": "dev-api-auth-karasu256-com",
      "vars": {
        "APP_ENV": "preview",
        "BETTER_AUTH_URL": "https://dev-api-auth.karasu256.com",
        "AUTH_UI_URL": "https://dev-auth.karasu256.com",
        "SSO_UI_URL": "https://dev-sso.karasu256.com",
        "ACCOUNTS_URL": "https://dev-accounts.karasu256.com",
        "MCP_URL": "https://dev-mcp.karasu256.com/mcp",
        "API_URL": "https://dev-api.karasu256.com",
        "MC_AUTH_URL": "https://dev-mc-auth.karasu256.com",
        "BASE_DOMAIN": "karasu256.com",
        "TRUSTED_ORIGINS":"[\"https://dev-accounts.karasu256.com\",\"https://*.dev-accounts.karasu256.com\",\"https://dev-auth.karasu256.com\",\"https://dev-sso.karasu256.com\",\"https://dev.karasu256.com\",\"https://dev-qr.karasu256.com\"]"
      },
      "routes": [{ "pattern": "dev-api-auth.karasu256.com", "custom_domain": true }],
      "ratelimits": [{ "name": "CLOUDFLARE_SIGN_IN_LOOKUP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
      "kv_namespaces": [{ "binding": "MINECRAFT_STATUS_RATE_LIMIT_KV", "id": "f92f5a167375432c970376fa40a05844" }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3876cf92143a4652bb2e6ecd7d2a3d07" }],
    },
    "local": {
      "routes": [],
      "kv_namespaces": [{ "binding": "VERIFICATION_RESEND_KV" }, { "binding": "MINECRAFT_STATUS_RATE_LIMIT_KV" }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "858c91ee12f54fb191816dd81a34ffe0",
          "localConnectionString": "postgres://postgres:postgres@localhost:5433/karasu256",
        },
      ],
      "vars": {
        "APP_ENV": "local",
        "ALLOWED_HOSTS": "local-api-auth.karasu256.com",
        "BETTER_AUTH_URL": "http://localhost:8790",
        "AUTH_UI_URL": "http://localhost:3004",
        "SSO_UI_URL": "http://localhost:3007",
        "ACCOUNTS_URL": "http://localhost:3001",
        "MCP_URL": "http://localhost:8791/mcp",
        "API_URL": "http://localhost:8789",
        "MC_AUTH_URL": "http://localhost:8793",
        "BETTER_AUTH_SECRET": "local-development-better-auth-secret-not-for-production",
        "INTERNAL_API_SECRET": "local-development-internal-api-secret",
        "UPSTASH_REDIS_REST_URL": "http://localhost:8079",
        "UPSTASH_REDIS_REST_TOKEN": "local-development-redis-token",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5433/karasu256",
        "GOOGLE_CLOUD_PROJECT_ID": "demo-karasu256",
        "FIREBASE_ADMIN_CLIENT_EMAIL": "firebase-adminsdk@demo-karasu256.iam.gserviceaccount.com",
        "FIREBASE_ADMIN_PRIVATE_KEY": "unused-with-emulator",
        "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
        "RESEND_API_KEY": "re_local_development",
        "RESEND_FROM_EMAIL": "noreply@example.com",
        "MICROSOFT_CLIENT_ID": "local-development-microsoft-client-id",
        "MICROSOFT_CLIENT_SECRET": "local-development-microsoft-client-secret",
        "CDN_URL": "http://localhost:8788",
        "STORAGE_ENDPOINT": "http://localhost:8333",
        "STORAGE_BUCKET": "cdn-local",
        "STORAGE_ACCESS_KEY_ID": "local-development-access-key-id",
        "STORAGE_SECRET_ACCESS_KEY": "local-development-secret-access-key",
      },
    },
  },
}
