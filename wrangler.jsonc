{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-auth-karasu256-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "routes": [{ "pattern": "api-auth.karasu256.com", "custom_domain": true }],
  "vars": {
    "APP_ENV": "production",
  },
  "ratelimits": [{ "name": "CLOUDFLARE_SIGN_IN_LOOKUP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "preview_urls": true,
  "previews": {
    "vars": {
      "APP_ENV": "preview",
    },
  },
  "env": {
    "local": {
      "routes": [],
      "vars": {
        "APP_ENV": "local",
        "BETTER_AUTH_SECRET": "local-development-better-auth-secret-not-for-production",
        "AUTH_SECRET": "local-development-auth-secret-not-for-production",
        "INTERNAL_API_SECRET": "local-development-internal-api-secret",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5433/karasu256",
        "FIREBASE_ADMIN_PROJECT_ID": "demo-karasu256",
        "FIREBASE_ADMIN_CLIENT_EMAIL": "firebase-adminsdk@demo-karasu256.iam.gserviceaccount.com",
        "FIREBASE_ADMIN_PRIVATE_KEY": "unused-with-emulator",
        "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
        "RESEND_API_KEY": "re_local_development",
        "RESEND_FROM_EMAIL": "noreply@example.com",
        "NEON_AUTH_BASE_URL": "http://localhost:3010/neondb/auth",
      },
    },
  },
}
