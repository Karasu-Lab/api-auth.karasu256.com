{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-auth-karasu256-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "routes": [{ "pattern": "api-auth.karasu256.com", "custom_domain": true }],  "vars": {
    "APP_ENV": "production",
    "CDN_URL": "https://cdn.karasu256.com",
    "STORAGE_BUCKET": "cdn",
    "GOOGLE_CLIENT_ID": "291377837692-haa4bsiure8qm70ionnaamb356qf6uca.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Iv23li7uADcoFUaks9lE",
    "MICROSOFT_CLIENT_ID": "3f583452-5b65-49a0-8df6-99264d2d876f",
  },
  "ratelimits": [{ "name": "CLOUDFLARE_SIGN_IN_LOOKUP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "858c91ee12f54fb191816dd81a34ffe0", "localConnectionString": "postgres://postgres:postgres@localhost:5433/karasu256" }],
  "preview_urls": true,
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "CDN_URL": "https://dev.cdn.karasu256.com",
      "STORAGE_BUCKET": "cdn",
      "GOOGLE_CLIENT_ID": "291377837692-haa4bsiure8qm70ionnaamb356qf6uca.apps.googleusercontent.com",
      "GITHUB_CLIENT_ID": "Iv23li7uADcoFUaks9lE",
      "MICROSOFT_CLIENT_ID": "3f583452-5b65-49a0-8df6-99264d2d876f",
    },
  },
  "env": {
    "local": {
      "routes": [],
      "vars": {
        "APP_ENV": "local",
        "BETTER_AUTH_SECRET": "local-development-better-auth-secret-not-for-production",
        "AUTH_SECRET": "local-development-auth-secret-not-for-production",
        "INTERNAL_API_SECRET": "local-development-internal-api-secret",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5433/karasu256",
        "GOOGLE_CLOUD_PROJECT_ID": "demo-karasu256",
        "FIREBASE_ADMIN_CLIENT_EMAIL": "firebase-adminsdk@demo-karasu256.iam.gserviceaccount.com",
        "FIREBASE_ADMIN_PRIVATE_KEY": "unused-with-emulator",
        "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
        "RESEND_API_KEY": "re_local_development",
        "RESEND_FROM_EMAIL": "noreply@example.com",
        "NEON_AUTH_BASE_URL": "http://localhost:3010/neondb/auth",
        "MICROSOFT_CLIENT_ID": "local-development-microsoft-client-id",
        "MICROSOFT_CLIENT_SECRET": "local-development-microsoft-client-secret",
        "CDN_URL": "http://localhost:8788",
        "STORAGE_ENDPOINT": "http://localhost:8333",
        "STORAGE_BUCKET": "cdn-local",
        "STORAGE_ACCESS_KEY_ID": "local-development-access-key-id",
        "STORAGE_SECRET_ACCESS_KEY": "local-development-secret-access-key",
      },
    },
  },
}
